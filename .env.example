# Copy this file to .env and fill in your Supabase project values
# (Project Settings -> API in the Supabase dashboard).
# EXPO_PUBLIC_* vars are bundled into the client app - only the anon key belongs here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Crash reporting. Leave blank to disable Sentry entirely; it is also disabled
# automatically in development builds.
EXPO_PUBLIC_SENTRY_DSN=

# Android only. react-native-maps uses Google Maps on Android and needs a key or
# the map renders blank; iOS uses Apple Maps and needs nothing. Read at build
# time by app.config.js, so it is never bundled into the JS.
GOOGLE_MAPS_ANDROID_API_KEY=

# Stripe publishable key. Safe to ship in the client - it can only create
# payment methods, never move money. Leave blank to run without card payments.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Set as Supabase Edge Function secrets, NOT here:
#   supabase secrets set STRIPE_SECRET_KEY=sk_...
#   supabase secrets set STRIPE_PUBLISHABLE_KEY=pk_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# The secret key must never appear in this file or in any EXPO_PUBLIC_ variable.

# Service-role key: ONLY used locally to run scripts/seed.mjs. Never put this in
# an EXPO_PUBLIC_ var, never commit it, never ship it in the app bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, used by scripts/seed.mjs only. The account must already exist
# (sign up in the app first). SEED_MERCHANT_EMAIL is linked as owner of every
# seeded restaurant; SEED_ADMIN_EMAIL is promoted to the admin role;
# SEED_COURIER_EMAIL is registered and approved as a courier.
SEED_MERCHANT_EMAIL=
SEED_ADMIN_EMAIL=
SEED_COURIER_EMAIL=
